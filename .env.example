# ----------------------------------------------------------------------------
# Pleasanton Events Hub — environment configuration
#
# Copy this file to `.env.local` for local development and fill in values.
# The app runs WITHOUT any of these set (it falls back to bundled mock data),
# so you can explore the UI immediately. Configure Supabase + Anthropic to
# enable persistence, real scraping, and AI normalization.
# ----------------------------------------------------------------------------

# --- Supabase -----------------------------------------------------------------
# Public (browser-safe) credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key. NEVER expose this to the browser.
# Used by the scraper and admin write operations.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (AI normalization of scraped event text, and the Ask page) -----
# One key enables both. Without it the Ask page falls back to keyword search.
ANTHROPIC_API_KEY=
# Optional override for scrape normalization; defaults to claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8
# Optional overrides for the Ask page (/ask). The model defaults to
# claude-opus-5; effort is low, medium (default), high, xhigh, or max.
ANTHROPIC_CHAT_MODEL=claude-opus-5
ANTHROPIC_CHAT_EFFORT=medium

# --- Admin & scraper auth -----------------------------------------------------
# Shared secret required to trigger /api/scrape and admin mutation endpoints.
# Generate with: openssl rand -hex 32
ADMIN_SECRET=

# --- Misc ---------------------------------------------------------------------
# Public base URL of the deployed site (used for canonical links / calendar).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
